# Vite `--mode test` (Playwright E2E). Firebase Emulator Suite only — never a live project.
# Every key also present in .env.local is overridden here so no production value leaks through.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-aurora-e2e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-aurora-e2e
VITE_FIREBASE_STORAGE_BUCKET=demo-aurora-e2e.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_USE_EMULATORS=true
VITE_POSTURA_FUNCTIONS_BASE=
VITE_POSTURA_E2E=true
