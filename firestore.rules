rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- SPEC-009 T-009-14e: denormalized envelope + ADMIN CREATE integrity ---
    //
    // Existing resources (READ/UPDATE/DELETE): resource.data envelope only — no parent get.
    // CLIENT CREATE: token + path + request.resource envelope — no parent get.
    // ADMIN CREATE (subcollections): request envelope + one parent get proving
    // clients/{clientId}.organizationId == tokenOrg() (referential integrity only).
    // Root clients/{clientId} CREATE: no parent (no parent client document).

    function signedIn() {
      return request.auth != null;
    }

    function tokenOrg() {
      return request.auth.token.organizationId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'ADMIN';
    }

    function isClient() {
      return signedIn() && request.auth.token.role == 'CLIENT';
    }

    function adminOfOrg(orgId) {
      return isAdmin() && tokenOrg() != null && tokenOrg() == orgId;
    }

    /** Root clients/{clientId}: organizationId only (clientId = path id). */
    function rootClientReadable(clientId) {
      return signedIn() && tokenOrg() != null
        && resource.data.keys().hasAll(['organizationId'])
        && resource.data.organizationId == tokenOrg()
        && (isAdmin() || (isClient() && request.auth.token.clientId == clientId));
    }

    /** Subcollection doc envelope on existing resource (READ/UPDATE/DELETE). */
    function existingSubEnvelopeValid(pathClientId) {
      return signedIn() && tokenOrg() != null
        && resource.data.keys().hasAll(['organizationId', 'clientId'])
        && resource.data.organizationId == tokenOrg()
        && resource.data.clientId == pathClientId
        && (isAdmin() || (isClient() && request.auth.token.clientId == pathClientId));
    }

    /** CREATE envelope for clients/{clientId}/... subcollections. */
    function createSubEnvelopeValid(pathClientId) {
      return signedIn() && tokenOrg() != null
        && request.resource.data.keys().hasAll(['organizationId', 'clientId'])
        && request.resource.data.organizationId == tokenOrg()
        && request.resource.data.clientId == pathClientId
        && (isAdmin() || (isClient() && request.auth.token.clientId == pathClientId));
    }

    /** ADMIN CREATE referential integrity: path client belongs to token org. */
    function parentClientDoc(clientId) {
      return get(/databases/$(database)/documents/clients/$(clientId));
    }

    function adminCreateParentClientOrgOk(clientId) {
      return parentClientDoc(clientId).data.keys().hasAll(['organizationId'])
        && parentClientDoc(clientId).data.organizationId == tokenOrg();
    }

    /** ADMIN subcollection CREATE: envelope + parent-client org integrity. */
    function adminCreateSub(pathClientId) {
      return isAdmin()
        && createSubEnvelopeValid(pathClientId)
        && adminCreateParentClientOrgOk(pathClientId);
    }

    /** CLIENT subcollection CREATE: token/path/request envelope only. */
    function clientCreateSub(pathClientId) {
      return isClient()
        && createSubEnvelopeValid(pathClientId);
    }

    function adminWriteSub(pathClientId) {
      return isAdmin() && existingSubEnvelopeValid(pathClientId) && preservesEnvelope();
    }

    function adminDeleteSub(pathClientId) {
      return isAdmin() && existingSubEnvelopeValid(pathClientId);
    }

    function ownsSubResource(pathClientId) {
      return existingSubEnvelopeValid(pathClientId);
    }

    function envelopeMatches(data) {
      return data.keys().hasAll(['organizationId'])
        && data.organizationId == tokenOrg()
        && (
          isAdmin()
          || (
            isClient()
            && data.keys().hasAll(['clientId'])
            && data.clientId == request.auth.token.clientId
          )
        );
    }

    /** Root clients/{clientId} CREATE (organizationId required; no duplicated clientId). */
    function createRootClientEnvelopeValid() {
      return isAdmin()
        && tokenOrg() != null
        && request.resource.data.keys().hasAll(['organizationId'])
        && request.resource.data.organizationId == tokenOrg();
    }

    function createEnvelopeValid() {
      return envelopeMatches(request.resource.data);
    }

    /**
     * Preserve organizationId/clientId when present on the existing resource,
     * and keep createdAt write-once (no change, add, or removal on UPDATE).
     */
    function preservesEnvelope() {
      return (!resource.data.keys().hasAny(['organizationId'])
          || request.resource.data.organizationId == resource.data.organizationId)
        && (!resource.data.keys().hasAny(['clientId'])
          || request.resource.data.clientId == resource.data.clientId)
        && !changedKeys().hasAny(['createdAt']);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(allowed) {
      return changedKeys().hasOnly(allowed);
    }

    /** Field must be unchanged, or set via serverTimestamp (request.time). */
    function trustedTimeOrUnchanged(field) {
      return !changedKeys().hasAny([field])
        || request.resource.data[field] == request.time;
    }

    // --- Phase 2: CLIENT field allowlists (T-009-04) ---

    function clientClientDocKeys() {
      return [
        'userId', 'onboardingStatus', 'profileCompleteness', 'status',
        'displayName', 'firstName', 'lastName', 'profession', 'company',
        'targetMarket', 'completedTasksCount', 'updatedAt'
      ];
    }

    function clientDeliveryKeys() {
      return ['status', 'acknowledgedAt', 'clientAckNote', 'updatedAt'];
    }

    function clientTaskKeys() {
      return ['status', 'clientNotes', 'evidenceUrl', 'completedAt', 'updatedAt'];
    }

    function clientContentKeys() {
      return [
        'title', 'body', 'clientFeedback', 'clientReviewBaseline',
        'pipelineStatus', 'status', 'updatedAt'
        // F-009-A MODEL B: stateHistory is non-authoritative; CLIENT must not mutate.
        // Canonical workflow = pipelineStatus; trusted clock = updatedAt.
      ];
    }

    function clientOpportunityKeys() {
      return [
        'clientDecision', 'clientNotes', 'status', 'lifecycleStage',
        'submissionChecklist', 'submittedAt', 'updatedAt'
      ];
    }

    function clientThesisApprovalKeys() {
      return [
        'clientApprovalStatus', 'clientApprovedAt', 'clientFeedback',
        'pendingRevision', 'status', 'updatedAt', 'updatedBy'
      ];
    }

    function thesisStrategicKeys() {
      return [
        'title', 'expertIdentity', 'targetAudience', 'secondaryAudience',
        'domain', 'objective', 'proofPoints', 'differentiator', 'voiceAndTone',
        'complianceRules', 'identityCurrent', 'perceptionTarget', 'audiences',
        'territories', 'objectives', 'voiceProfile', 'limits', 'priority'
      ];
    }

    function clientThesisKeys() {
      return clientThesisApprovalKeys().concat(thesisStrategicKeys());
    }

    // --- Phase 2: state machines (T-009-05) ---

    function clientDeliveryTransitionOk() {
      return resource.data.status == 'SENT'
        && request.resource.data.status == 'ACKNOWLEDGED'
        && request.resource.data.acknowledgedAt == request.time;
    }

    function clientDeliveryIdempotentOk() {
      return resource.data.status == request.resource.data.status
        && resource.data.status == 'ACKNOWLEDGED'
        && trustedTimeOrUnchanged('acknowledgedAt');
    }

    function clientTaskTransitionOk() {
      let oldS = resource.data.status;
      let newS = request.resource.data.status;
      return oldS == newS
        || (oldS == 'DRAFT' && newS in ['VIEWED', 'IN_PROGRESS'])
        || (oldS == 'ASSIGNED' && newS in ['VIEWED', 'IN_PROGRESS'])
        || (oldS == 'VIEWED' && newS in ['IN_PROGRESS', 'COMPLETED'])
        || (oldS == 'IN_PROGRESS' && newS == 'COMPLETED');
    }

    function clientTaskCompletedAtOk() {
      return request.resource.data.status != 'COMPLETED'
        || request.resource.data.completedAt == request.time;
    }

    function clientPipelineTransitionOk() {
      let oldP = resource.data.keys().hasAny(['pipelineStatus'])
        ? resource.data.pipelineStatus
        : '';
      let newP = request.resource.data.keys().hasAny(['pipelineStatus'])
        ? request.resource.data.pipelineStatus
        : oldP;
      return oldP == newP
        || (oldP == 'sent_to_client' && newP in ['client_in_progress', 'client_submitted', 'manager_finalizing'])
        || (oldP == 'client_in_progress' && newP in ['client_in_progress', 'client_submitted', 'manager_finalizing'])
        || (oldP == 'client_submitted' && newP == 'manager_finalizing');
    }

    function clientLegacyContentStatusOk() {
      let oldS = resource.data.keys().hasAny(['status']) ? resource.data.status : '';
      let newS = request.resource.data.keys().hasAny(['status']) ? request.resource.data.status : oldS;
      return oldS == newS
        || (oldS == 'CLIENT_REVIEW' && newS in ['CHANGES_REQUESTED', 'CLIENT_APPROVED'])
        || (oldS == 'CHANGES_REQUESTED' && newS in ['CLIENT_APPROVED', 'CHANGES_REQUESTED']);
    }

    function clientContentStateHistoryOk() {
      // F-009-A MODEL B: stateHistory non-authoritative; deny any CLIENT mutation.
      return !changedKeys().hasAny(['stateHistory']);
    }

    function clientOpportunityTransitionOk() {
      let oldS = resource.data.status;
      let newS = request.resource.data.status;
      let decision = request.resource.data.keys().hasAny(['clientDecision'])
        ? request.resource.data.clientDecision
        : '';
      return oldS == newS
        || (oldS in ['SENT_TO_CLIENT', 'RECOMMENDED'] && newS == 'IN_PROGRESS' && decision == 'ACCEPTED')
        || (oldS in ['SENT_TO_CLIENT', 'RECOMMENDED'] && newS == 'REJECTED' && decision == 'REJECTED')
        || (oldS == 'IN_PROGRESS' && newS == 'COMPLETED')
        || (oldS == 'ACCEPTED' && newS == 'IN_PROGRESS');
    }

    function clientOpportunitySubmittedAtOk() {
      return request.resource.data.status != 'COMPLETED'
        || request.resource.data.submittedAt == request.time
        || (!changedKeys().hasAny(['submittedAt']) && resource.data.status == 'COMPLETED');
    }

    function thesisApplyingRevision() {
      return resource.data.keys().hasAny(['pendingRevision'])
        && resource.data.pendingRevision.keys().hasAll(['proposed'])
        && resource.data.keys().hasAll(['clientApprovalStatus'])
        && resource.data.clientApprovalStatus == 'PENDING'
        && request.resource.data.keys().hasAll(['clientApprovalStatus'])
        && request.resource.data.clientApprovalStatus == 'APPROVED'
        && (
          !request.resource.data.keys().hasAny(['pendingRevision'])
          || request.resource.data.pendingRevision == null
        );
    }

    /** Strategic keys changed outside pendingRevision.proposed → DENY. */
    function thesisNoStrategicOutsideProposed(ch, pk) {
      return (!ch.hasAny(['title']) || pk.hasAny(['title']))
        && (!ch.hasAny(['expertIdentity']) || pk.hasAny(['expertIdentity']))
        && (!ch.hasAny(['targetAudience']) || pk.hasAny(['targetAudience']))
        && (!ch.hasAny(['secondaryAudience']) || pk.hasAny(['secondaryAudience']))
        && (!ch.hasAny(['domain']) || pk.hasAny(['domain']))
        && (!ch.hasAny(['objective']) || pk.hasAny(['objective']))
        && (!ch.hasAny(['proofPoints']) || pk.hasAny(['proofPoints']))
        && (!ch.hasAny(['differentiator']) || pk.hasAny(['differentiator']))
        && (!ch.hasAny(['voiceAndTone']) || pk.hasAny(['voiceAndTone']))
        && (!ch.hasAny(['complianceRules']) || pk.hasAny(['complianceRules']))
        && (!ch.hasAny(['identityCurrent']) || pk.hasAny(['identityCurrent']))
        && (!ch.hasAny(['perceptionTarget']) || pk.hasAny(['perceptionTarget']))
        && (!ch.hasAny(['audiences']) || pk.hasAny(['audiences']))
        && (!ch.hasAny(['territories']) || pk.hasAny(['territories']))
        && (!ch.hasAny(['objectives']) || pk.hasAny(['objectives']))
        && (!ch.hasAny(['voiceProfile']) || pk.hasAny(['voiceProfile']))
        && (!ch.hasAny(['limits']) || pk.hasAny(['limits']))
        && (!ch.hasAny(['priority']) || pk.hasAny(['priority']));
    }

    /** Only keys present in proposed are value-checked (no arbitrary Y). */
    function thesisAllProposedApplied(p, pk) {
      return (!pk.hasAny(['title']) || request.resource.data.title == p.title)
        && (!pk.hasAny(['expertIdentity']) || request.resource.data.expertIdentity == p.expertIdentity)
        && (!pk.hasAny(['targetAudience']) || request.resource.data.targetAudience == p.targetAudience)
        && (!pk.hasAny(['secondaryAudience']) || request.resource.data.secondaryAudience == p.secondaryAudience)
        && (!pk.hasAny(['domain']) || request.resource.data.domain == p.domain)
        && (!pk.hasAny(['objective']) || request.resource.data.objective == p.objective)
        && (!pk.hasAny(['proofPoints']) || request.resource.data.proofPoints == p.proofPoints)
        && (!pk.hasAny(['differentiator']) || request.resource.data.differentiator == p.differentiator)
        && (!pk.hasAny(['voiceAndTone']) || request.resource.data.voiceAndTone == p.voiceAndTone)
        && (!pk.hasAny(['complianceRules']) || request.resource.data.complianceRules == p.complianceRules)
        && (!pk.hasAny(['identityCurrent']) || request.resource.data.identityCurrent == p.identityCurrent)
        && (!pk.hasAny(['perceptionTarget']) || request.resource.data.perceptionTarget == p.perceptionTarget)
        && (!pk.hasAny(['audiences']) || request.resource.data.audiences == p.audiences)
        && (!pk.hasAny(['territories']) || request.resource.data.territories == p.territories)
        && (!pk.hasAny(['objectives']) || request.resource.data.objectives == p.objectives)
        && (!pk.hasAny(['voiceProfile']) || request.resource.data.voiceProfile == p.voiceProfile)
        && (!pk.hasAny(['limits']) || request.resource.data.limits == p.limits)
        && (!pk.hasAny(['priority']) || request.resource.data.priority == p.priority);
    }

    function thesisStrategicApplyMatchesProposed(ch) {
      let p = resource.data.pendingRevision.proposed;
      let pk = p.keys();
      return thesisNoStrategicOutsideProposed(ch, pk)
        && thesisAllProposedApplied(p, pk);
    }

    function clientThesisApprovalTransitionOk() {
      let oldA = resource.data.keys().hasAny(['clientApprovalStatus'])
        ? resource.data.clientApprovalStatus
        : 'PENDING';
      let newA = request.resource.data.keys().hasAny(['clientApprovalStatus'])
        ? request.resource.data.clientApprovalStatus
        : oldA;
      let oldS = resource.data.keys().hasAny(['status']) ? resource.data.status : '';
      let newS = request.resource.data.keys().hasAny(['status']) ? request.resource.data.status : oldS;
      return (oldA == newA && oldS == newS)
        || (oldA == 'PENDING' && newA == 'APPROVED')
        || (oldA == 'PENDING' && newA == 'CHANGES_REQUESTED')
        || (oldS == 'UNDER_REVIEW' && newS == 'DRAFT' && newA == 'CHANGES_REQUESTED')
        || (oldS == newS && oldA == newA);
    }

    /**
     * F-009-B: one affectedKeys() for the whole CLIENT thesis UPDATE path.
     * Avoids repeated diff() from onlyChanged + strategic + trustedTime helpers.
     */
    function clientThesisUpdateOk() {
      let ch = request.resource.data.diff(resource.data).affectedKeys();
      return ch.hasOnly(clientThesisKeys())
        && clientThesisApprovalTransitionOk()
        && (
          !ch.hasAny(thesisStrategicKeys())
          || (thesisApplyingRevision() && thesisStrategicApplyMatchesProposed(ch))
        )
        && (!ch.hasAny(['clientApprovedAt']) || request.resource.data.clientApprovedAt == request.time)
        && (!ch.hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time);
    }

    function clientProfileKeys() {
      return [
        'organizationId', 'clientId',
        'identity', 'goals', 'audience', 'career', 'education', 'careerHistory',
        'ventures', 'keyPublications', 'socialLinks', 'voicePreferences',
        'facts', 'cvExtractedText', 'onboardingCompleted', 'onboardingCurrentStep',
        'updatedAt'
      ];
    }

    // --- T-009-04 / T-009-05n: notification CREATE schema (manager-alert) ---

    function managerAlertNotificationCreate(clientId) {
      return request.resource.data.keys().hasOnly([
          'id', 'userId', 'clientId', 'organizationId', 'type',
          'title', 'body', 'href', 'targetId', 'read', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'userId', 'clientId', 'organizationId', 'type',
          'title', 'body', 'read', 'createdAt'
        ])
        && request.resource.data.organizationId == tokenOrg()
        && request.resource.data.clientId == clientId
        && request.resource.data.clientId == request.auth.token.clientId
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.type in [
          'TASK_ASSIGNED', 'CONTENT_REVIEW', 'OPPORTUNITY',
          'ONBOARDING', 'THESIS', 'SYSTEM', 'BRIEFING'
        ];
    }

    function clientNotificationUpdateOk() {
      return onlyChanged(['read', 'updatedAt', 'organizationId', 'clientId'])
        && preservesEnvelope()
        && (
          (resource.data.read == false && request.resource.data.read == true)
          || (resource.data.read == true && request.resource.data.read == true)
        )
        && !changedKeys().hasAny(['title', 'body', 'type', 'userId', 'href', 'targetId', 'id']);
    }

    match /organizations/{orgId} {
      allow read: if signedIn() && tokenOrg() == orgId;
      allow create, update: if adminOfOrg(orgId);
      allow delete: if adminOfOrg(orgId);
    }

    match /clients/{clientId} {
      allow get: if rootClientReadable(clientId);
      allow list: if signedIn()
        && tokenOrg() != null
        && resource.data.organizationId == tokenOrg()
        && (isAdmin() || request.auth.token.clientId == clientId);
      allow create: if createRootClientEnvelopeValid();
      allow update: if preservesEnvelope() && (
        (isAdmin() && adminOfOrg(resource.data.organizationId))
        || (
          isClient()
          && request.auth.token.clientId == clientId
          && resource.data.keys().hasAll(['organizationId'])
          && resource.data.organizationId == tokenOrg()
          && onlyChanged(clientClientDocKeys())
          && trustedTimeOrUnchanged('updatedAt')
        )
      );
      allow delete: if isAdmin() && adminOfOrg(resource.data.organizationId);
    }

    match /clients/{clientId}/sources/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/signals/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/curation/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/theses/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow delete: if adminDeleteSub(clientId);
      allow update: if ownsSubResource(clientId) && preservesEnvelope() && (
        isAdmin()
        || (isClient() && clientThesisUpdateOk())
      );
    }
    match /clients/{clientId}/recommendations/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/campaigns/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/campaignMilestones/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/advices/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }

    match /clients/{clientId}/deliveries/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow delete: if adminDeleteSub(clientId);
      allow update: if ownsSubResource(clientId) && preservesEnvelope() && (
        isAdmin()
        || (
          isClient()
          && onlyChanged(clientDeliveryKeys())
          && (clientDeliveryTransitionOk() || clientDeliveryIdempotentOk())
        )
      );
    }

    match /clients/{clientId}/notifications/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if createSubEnvelopeValid(clientId) && (
        (isAdmin()
          && adminCreateParentClientOrgOk(clientId)
          && request.resource.data.keys().hasAll(['type', 'title', 'body', 'read', 'createdAt'])
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time)
        || (isClient() && managerAlertNotificationCreate(clientId))
      );
      allow update: if ownsSubResource(clientId) && (
        (isAdmin() && preservesEnvelope())
        || (isClient() && clientNotificationUpdateOk())
      );
      allow delete: if adminDeleteSub(clientId);
    }

    match /clients/{clientId}/tasks/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow delete: if adminDeleteSub(clientId);
      allow update: if ownsSubResource(clientId) && preservesEnvelope() && (
        isAdmin()
        || (
          isClient()
          && onlyChanged(clientTaskKeys())
          && clientTaskTransitionOk()
          && clientTaskCompletedAtOk()
          && trustedTimeOrUnchanged('completedAt')
          && trustedTimeOrUnchanged('updatedAt')
        )
      );
    }

    match /clients/{clientId}/contents/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow delete: if adminDeleteSub(clientId);
      allow update: if ownsSubResource(clientId) && preservesEnvelope() && (
        isAdmin()
        || (
          isClient()
          && onlyChanged(clientContentKeys())
          && clientPipelineTransitionOk()
          && clientLegacyContentStatusOk()
          && clientContentStateHistoryOk()
          && trustedTimeOrUnchanged('updatedAt')
        )
      );
    }

    match /clients/{clientId}/opportunities/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow delete: if adminDeleteSub(clientId);
      allow update: if ownsSubResource(clientId) && preservesEnvelope() && (
        isAdmin()
        || (
          isClient()
          && onlyChanged(clientOpportunityKeys())
          && clientOpportunityTransitionOk()
          && clientOpportunitySubmittedAtOk()
          && trustedTimeOrUnchanged('submittedAt')
          && trustedTimeOrUnchanged('updatedAt')
        )
      );
    }

    match /clients/{clientId}/profile/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if createSubEnvelopeValid(clientId) && (
        (isAdmin() && adminCreateParentClientOrgOk(clientId))
        || (
          isClient()
          && request.auth.token.clientId == clientId
          && request.resource.data.keys().hasOnly(clientProfileKeys())
          && request.resource.data.keys().hasAll(['organizationId', 'clientId'])
          && request.resource.data.organizationId == tokenOrg()
          && request.resource.data.clientId == clientId
          && trustedTimeOrUnchanged('updatedAt')
        )
      );
      allow update: if existingSubEnvelopeValid(clientId) && preservesEnvelope() && (
        isAdmin()
        || (
          isClient()
          && request.auth.token.clientId == clientId
          && request.resource.data.keys().hasOnly(clientProfileKeys())
          && request.resource.data.keys().hasAll(['organizationId', 'clientId'])
          && request.resource.data.organizationId == tokenOrg()
          && request.resource.data.clientId == clientId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.clientId == resource.data.clientId
          && trustedTimeOrUnchanged('updatedAt')
        )
      );
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/dossier/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }

    match /clients/{clientId}/evidence/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if request.resource.data.createdAt == request.time && (
        adminCreateSub(clientId) || clientCreateSub(clientId)
      );
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/results/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if request.resource.data.createdAt == request.time && (
        adminCreateSub(clientId) || clientCreateSub(clientId)
      );
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/feedbackEvents/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if request.resource.data.createdAt == request.time && (
        adminCreateSub(clientId) || clientCreateSub(clientId)
      );
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }

    // SEC-009-019: CLIENT deny read + write; feedback via feedbackEvents
    match /clients/{clientId}/signalOutcomes/{docId} {
      allow read: if isAdmin() && existingSubEnvelopeValid(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }
    match /clients/{clientId}/proofWallItems/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }

    match /clients/{clientId}/aiRuns/{docId} {
      allow read: if ownsSubResource(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId);
      allow delete: if adminDeleteSub(clientId);
    }

    // T604: Strategic Briefs are ADMIN-only. A Brief never moves back to an older
    // version; history and override audit records are append-only (an identical
    // rewrite is the only update) and no Brief record is ever deleted.
    match /clients/{clientId}/strategicBriefs/{docId} {
      allow read: if isAdmin() && existingSubEnvelopeValid(clientId);
      allow create: if adminCreateSub(clientId) && request.resource.data.id == docId;
      allow update: if adminWriteSub(clientId)
        && request.resource.data.id == docId
        && request.resource.data.version is int
        && request.resource.data.version >= resource.data.version;
      allow delete: if false;
    }
    match /clients/{clientId}/strategicBriefHistory/{docId} {
      allow read: if isAdmin() && existingSubEnvelopeValid(clientId);
      allow create: if adminCreateSub(clientId);
      allow update: if adminWriteSub(clientId) && request.resource.data == resource.data;
      allow delete: if false;
    }
    match /clients/{clientId}/strategicBriefOverrides/{docId} {
      allow read: if isAdmin() && existingSubEnvelopeValid(clientId);
      allow create: if adminCreateSub(clientId) && request.resource.data.overrideId == docId;
      allow update: if adminWriteSub(clientId) && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin()
        && tokenOrg() != null
        && resource.data.organizationId == tokenOrg();
      allow create: if isAdmin()
        && tokenOrg() != null
        && request.resource.data.organizationId == tokenOrg();
      allow update, delete: if false;
    }
  }
}
