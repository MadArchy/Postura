{
  "name": "postura-system",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src server tests e2e --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-aurora-e2e --only firestore,storage \"npx vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --project demo-aurora-e2e --only auth,firestore,storage \"npx playwright test\"",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:deploy:functions": "npm --prefix functions run build && firebase deploy --only functions",
    "firebase:deploy": "npm run build && firebase deploy",
    "firebase:provision": "node scripts/provision-firebase.mjs",
    "firebase:prep": "node scripts/firebase-prep-check.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "spec009:prod:audit": "node scripts/spec009-envelope-dryrun.mjs",
    "spec009:prod:backup": "node scripts/spec009-firestore-backup.mjs",
    "validate:juan-tavily": "node scripts/validate-juan-tavily-flow.mjs",
    "probe:feeds": "node scripts/probe-source-feeds.mjs",
    "checklist:functions": "node scripts/deploy-functions-checklist.mjs",
    "checklist:pilot": "node scripts/pilot-juan-walkthrough.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^13.2.0",
    "firebase-tools": "^15.14.0",
    "globals": "^16.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.6",
    "firebase": "^11.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "zod": "^4.4.3"
  }
}
