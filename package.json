{
  "name": "postura-system",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src server tests --ext .ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage \"npx vitest run --config vitest.rules.config.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:deploy:functions": "npm --prefix functions run build && firebase deploy --only functions",
    "firebase:deploy": "npm run build && firebase deploy",
    "firebase:provision": "node scripts/provision-firebase.mjs",
    "firebase:prep": "node scripts/firebase-prep-check.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "spec009:backup": "node scripts/spec009-firestore-backup.mjs",
    "spec009:dryrun": "node scripts/spec009-envelope-dryrun.mjs --skip-backup",
    "validate:juan-tavily": "node scripts/validate-juan-tavily-flow.mjs",
    "probe:feeds": "node scripts/probe-source-feeds.mjs",
    "checklist:functions": "node scripts/deploy-functions-checklist.mjs",
    "checklist:pilot": "node scripts/pilot-juan-walkthrough.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "firebase-admin": "^13.2.0",
    "firebase-tools": "^15.14.0",
    "globals": "^16.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "firebase": "^11.6.0"
  }
}
